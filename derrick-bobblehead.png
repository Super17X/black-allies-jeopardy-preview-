#bobblehead-widget{position:fixed;right:14px;bottom:14px;z-index:9990;width:min(270px,35vw);height:min(440px,58vh);pointer-events:none;font-family:system-ui,-apple-system,Segoe UI,sans-serif;isolation:isolate}
#bobblehead-widget.bh-hidden{display:none}
.bh-bubble{position:absolute;right:12px;bottom:78%;max-width:230px;background:rgba(10,9,16,.94);color:#fff;border:1px solid rgba(247,201,72,.72);border-radius:16px;padding:11px 13px;font-weight:800;line-height:1.2;box-shadow:0 12px 35px #0009,0 0 22px rgba(247,201,72,.12);opacity:0;transform:translateY(8px) scale(.96);transition:.22s ease;backdrop-filter:blur(10px)}
.bh-bubble.show{opacity:1;transform:none}.bh-bubble:after{content:"";position:absolute;right:32px;bottom:-11px;border:6px solid transparent;border-top-color:rgba(247,201,72,.72)}
.bh-stage{position:absolute;right:0;bottom:0;width:100%;height:100%;pointer-events:auto;cursor:pointer;transform-origin:50% 92%;animation:bhIdle 3.1s ease-in-out infinite;filter:drop-shadow(0 16px 18px rgba(0,0,0,.58));will-change:transform,filter}
.bh-portrait{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center bottom;display:block;border:0!important;outline:0!important;box-shadow:none!important;background:transparent!important;
  -webkit-mask-image:linear-gradient(to right,transparent 0,#000 7%,#000 93%,transparent 100%),linear-gradient(to bottom,transparent 0,#000 5%,#000 95%,transparent 100%);
  -webkit-mask-composite:source-in;mask-image:linear-gradient(to right,transparent 0,#000 7%,#000 93%,transparent 100%),linear-gradient(to bottom,transparent 0,#000 5%,#000 95%,transparent 100%);mask-composite:intersect}
.bh-stage:after{content:"";position:absolute;left:16%;right:10%;bottom:1.5%;height:8%;border-radius:50%;background:radial-gradient(ellipse,rgba(247,201,72,.20),rgba(0,0,0,0) 68%);filter:blur(8px);z-index:-1}
.bh-controls{position:absolute;right:4px;bottom:-2px;transform:translateY(100%);display:flex;gap:6px;pointer-events:auto}.bh-controls button{border:1px solid rgba(247,201,72,.65);background:rgba(8,7,14,.9);color:#ffd84f;border-radius:999px;padding:4px 8px;font-size:11px;font-weight:800;cursor:pointer;backdrop-filter:blur(8px)}
#bobblehead-widget.bh-correct .bh-stage{animation:bhCelebrate .42s ease-in-out 3}#bobblehead-widget.bh-wrong .bh-stage{animation:bhNo .27s ease-in-out 3}#bobblehead-widget.bh-daily .bh-stage{animation:bhDaily .58s ease-in-out 4}
@keyframes bhIdle{0%,100%{transform:rotate(-.7deg) translateY(0)}50%{transform:rotate(.7deg) translateY(-3px)}}
@keyframes bhCelebrate{0%,100%{transform:rotate(0) translateY(0) scale(1)}50%{transform:rotate(2.2deg) translateY(-14px) scale(1.035)}}
@keyframes bhNo{0%,100%{transform:rotate(0)}33%{transform:rotate(-2.6deg)}66%{transform:rotate(2.6deg)}}
@keyframes bhDaily{0%,100%{transform:scale(1);filter:drop-shadow(0 16px 18px rgba(0,0,0,.58))}50%{transform:scale(1.045);filter:drop-shadow(0 0 26px rgba(255,216,79,.78)) drop-shadow(0 16px 18px rgba(0,0,0,.58))}}
@media(max-width:800px){#bobblehead-widget{right:3px;bottom:8px;width:min(205px,38vw);height:min(335px,48vh)}.bh-bubble{right:2px;max-width:185px;font-size:.84rem}.bh-controls{display:none}}
@media(max-width:480px){#bobblehead-widget{width:150px;height:250px;opacity:.96}.bh-bubble{bottom:76%;max-width:150px;font-size:.74rem;padding:8px 10px}}
@media(prefers-reduced-motion:reduce){.bh-stage{animation:none!important}}
